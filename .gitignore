# ==============================================================================
# .gitignore for ML Synthetic Data Clustering Research
# ==============================================================================

# ============================================================
# Generated Data Files
# ============================================================
ofarres/data/real/*.csv
ofarres/data/synthetic/*.csv

# Keep directory structure
!ofarres/data/real/.gitkeep
!ofarres/data/synthetic/.gitkeep

# ============================================================
# Results & Output Files
# ============================================================
ofarres/02_clustering/clustering_results_final.csv
ofarres/03_analysis/plot*.png
ofarres/03_analysis/graphic*.png
ofarres/03_analysis/*_executed.ipynb

# ============================================================
# Python
# ============================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
synthetic_data/

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py

# ============================================================
# R
# ============================================================
# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# RStudio files
.Rproj.user/
*.Rproj

# R Environment Variables
.Renviron

# pkgdown site
docs/

# ============================================================
# OS Generated Files
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================================
# IDE & Editor Files
# ============================================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# ============================================================
# Logs & Temporary Files
# ============================================================
*.log
*.tmp
*.temp
*.cache
pipeline.log

# ============================================================
# Archives & Compressed Files
# ============================================================
*.zip
*.tar.gz
*.tar
*.rar
*.7z

# ============================================================
# Large Data Files
# ============================================================
*.csv.bak
*.csv.old
backup/

# ============================================================
# Old/Backup Files
# ============================================================
*_old.*
*_backup.*
requirements_old_jupyterlab.txt
README_old.md

# ============================================================
# Keep These Files
# ============================================================
!.gitignore
!README.md
!ofarres/SETUP.md
!ofarres/requirements.txt
!ofarres/config/config.json
