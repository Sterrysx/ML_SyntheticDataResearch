# ==============================================================================
# .gitignore for ML Synthetic Data Clustering Research
# ==============================================================================

# ============================================================
# Generated Data Files
# ============================================================
clustering/data/real/*
clustering/data/synthetic/*

# Ignore all files in the regression data folders
regression/data/original/*
regression/data/synthetic/*

regression/data/*

# Ignore the heavy raw results, but keep the summary and plots
regression/results/aggregated_model_metrics.parquet

regression/results/evaluation_metrics.parquet
regression/results/figures/
regression/results/**
!regression/results/.gitkeep
!regression/results/**/.gitkeep
regression/.codex

# Keep the directory structure intact (optional but recommended)
!regression/data/original/.gitkeep
!regression/data/synthetic/.gitkeep

# Keep directory structure
!clustering/data/real/.gitkeep
!clustering/data/synthetic/.gitkeep

regression/models/*.pkl

# Ignore everything inside the data directory
regression/data/**/*

# Optional: Ensure the folders stay in git even if empty (requires a .gitkeep file inside them)
!regression/data/**/.gitkeep


# ============================================================
# Results & Output Files
# ============================================================
clustering/02_clustering/clustering_results_final.csv
clustering/03_analysis/plot*.png
clustering/03_analysis/graphic*.png
clustering/03_analysis/*_executed.ipynb

# ============================================================
# Python
# ============================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
synthetic_data/

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py

# ============================================================
# R
# ============================================================
# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# RStudio files
.Rproj.user/
*.Rproj

# R Environment Variables
.Renviron


# ============================================================
# OS Generated Files
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================================
# IDE & Editor Files
# ============================================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# ============================================================
# Logs & Temporary Files
# ============================================================
*.log
*.tmp
*.temp
*.cache
pipeline.log

# ============================================================
# Archives & Compressed Files
# ============================================================
*.zip
*.tar.gz
*.tar
*.rar
*.7z

# ============================================================
# Large Data Files
# ============================================================
*.csv.bak
*.csv.old
backup/

# ============================================================
# Old/Backup Files
# ============================================================
*_old.*
*_backup.*
requirements_old_jupyterlab.txt
README_old.md

# ============================================================
# Keep These Files
# ============================================================
!.gitignore
!README.md
!clustering/SETUP.md
!clustering/requirements.txt
!clustering/config/config.json
